FROM python:3.12-slim

# Install Java and C++ compilers
RUN apt-get update && apt-get install -y \
    g++ \
    default-jdk \
    && rm -rf /var/lib/apt/lists/*

# Create a non-root user for security
RUN useradd -m sandbox_user

WORKDIR /workspace
RUN chown sandbox_user:sandbox_user /workspace

USER sandbox_user

# The default command is overridden by the sandbox script
CMD ["/bin/bash"]
