[
  {
    "id": 31,
    "category": "algorithmic",
    "title": "Jump Game",
    "description": "Given an integer array `nums`, where each element represents your maximum jump length from that position, return True if you can reach the last index starting from the first index.",
    "difficulty": 5,
    "function_signature": "def can_jump(nums: list[int]) -> bool:",
    "reference_solution": "def can_jump(nums):\n    max_reach = 0\n    for i, n in enumerate(nums):\n        if i > max_reach: return False\n        max_reach = max(max_reach, i + n)\n    return True",
    "tests": [
      {
        "id": 0,
        "input": "can_jump([2,3,1,1,4])",
        "expected": "True"
      },
      {
        "id": 1,
        "input": "can_jump([3,2,1,0,4])",
        "expected": "False"
      },
      {
        "id": 2,
        "input": "can_jump([0])",
        "expected": "True"
      },
      {
        "id": 3,
        "input": "can_jump([1,0])",
        "expected": "True"
      },
      {
        "id": 4,
        "input": "can_jump([0,1])",
        "expected": "False"
      },
      {
        "id": 5,
        "input": "can_jump([1,1,1,1])",
        "expected": "True"
      },
      {
        "id": 6,
        "input": "can_jump([2,0,0])",
        "expected": "True"
      },
      {
        "id": 7,
        "input": "can_jump([1,2,3])",
        "expected": "True"
      },
      {
        "id": 8,
        "input": "can_jump([5,0,0,0,0,0])",
        "expected": "True"
      },
      {
        "id": 9,
        "input": "can_jump([2,0,1,0,1])",
        "expected": "False"
      },
      {
        "id": 10,
        "input": "can_jump([-7, 2, 5, 7, -9, 6])",
        "expected": "False"
      },
      {
        "id": 11,
        "input": "can_jump([368])",
        "expected": "True"
      },
      {
        "id": 12,
        "input": "can_jump([-2, 3, -3])",
        "expected": "False"
      },
      {
        "id": 13,
        "input": "can_jump([287, 702, -846, 35, -608, 666, 668, 429, -680, -950, -953, -470, -723, -834, -292, 273, -813, 412, -301, 901, -409, -637, 801, 995, -688, -684, 380, -799])",
        "expected": "True"
      },
      {
        "id": 14,
        "input": "can_jump([9, -3, 5])",
        "expected": "True"
      },
      {
        "id": 15,
        "input": "can_jump([])",
        "expected": "True"
      },
      {
        "id": 16,
        "input": "can_jump([-4, 5, 8, 5, 10])",
        "expected": "False"
      },
      {
        "id": 17,
        "input": "can_jump([-47, -552, -373, 322, -616, 462, 111, -10, 285, 341, 217, 360, -748, 821, -897, 651, -572, -660, -60, 458, -323])",
        "expected": "False"
      },
      {
        "id": 18,
        "input": "can_jump([-5, 2, -5, 9])",
        "expected": "False"
      },
      {
        "id": 19,
        "input": "can_jump([515])",
        "expected": "True"
      }
    ]
  },
  {
    "id": 32,
    "category": "data_structures",
    "title": "Binary Search Tree Validator",
    "description": "Given the preorder traversal of a BST as a list of integers, return True if it is a valid BST preorder sequence, False otherwise. Each element is unique.",
    "difficulty": 6,
    "function_signature": "def verify_preorder(preorder: list[int]) -> bool:",
    "reference_solution": "def verify_preorder(preorder):\n    stack, lo = [], float('-inf')\n    for val in preorder:\n        if val < lo: return False\n        while stack and stack[-1] < val:\n            lo = stack.pop()\n        stack.append(val)\n    return True",
    "tests": [
      {
        "id": 0,
        "input": "verify_preorder([5,2,1,3,6])",
        "expected": "True"
      },
      {
        "id": 1,
        "input": "verify_preorder([5,2,6,1,3])",
        "expected": "False"
      },
      {
        "id": 2,
        "input": "verify_preorder([5,3,6,2,4])",
        "expected": "False"
      },
      {
        "id": 3,
        "input": "verify_preorder([1])",
        "expected": "True"
      },
      {
        "id": 4,
        "input": "verify_preorder([5,2,1,3])",
        "expected": "True"
      },
      {
        "id": 5,
        "input": "verify_preorder([10,5,2,7,15,12,20])",
        "expected": "True"
      },
      {
        "id": 6,
        "input": "verify_preorder([3,1,2])",
        "expected": "True"
      },
      {
        "id": 7,
        "input": "verify_preorder([1,2,3,4,5])",
        "expected": "True"
      },
      {
        "id": 8,
        "input": "verify_preorder([5,4,3,2,1])",
        "expected": "True"
      },
      {
        "id": 9,
        "input": "verify_preorder([3,2,4,1])",
        "expected": "False"
      },
      {
        "id": 10,
        "input": "verify_preorder([-6, 0, 7, 8, 5])",
        "expected": "False"
      },
      {
        "id": 11,
        "input": "verify_preorder([596])",
        "expected": "True"
      },
      {
        "id": 12,
        "input": "verify_preorder([-5, 0, 7])",
        "expected": "True"
      },
      {
        "id": 13,
        "input": "verify_preorder([873, 919, 267, 813, -138, -431, -85, -364, -978, -782, -731, -935, -443, -655, -670, -379, 192])",
        "expected": "False"
      },
      {
        "id": 14,
        "input": "verify_preorder([4, 9, 2])",
        "expected": "False"
      },
      {
        "id": 15,
        "input": "verify_preorder([])",
        "expected": "True"
      },
      {
        "id": 16,
        "input": "verify_preorder([-4, 7, -5, -5, -5, -1, -5, -2])",
        "expected": "False"
      },
      {
        "id": 17,
        "input": "verify_preorder([-708, 268, 2, -988, 836, 18, -539, -746, 859, 247, -937, 265, 449, -32, -899, -767, -330, 777, 339, 558, 342, 260])",
        "expected": "False"
      },
      {
        "id": 18,
        "input": "verify_preorder([-2, 9, 10, 9, 5, -6, 8, 7, -8, 7])",
        "expected": "False"
      },
      {
        "id": 19,
        "input": "verify_preorder([-516])",
        "expected": "True"
      }
    ]
  },
  {
    "id": 33,
    "category": "string_parsing",
    "title": "Decode Ways",
    "description": "A message is encoded as digits (1='A' to 26='Z'). Given a string `s` of digits, return the number of ways to decode it. '0' is invalid unless preceded by '1' or '2'.",
    "difficulty": 6,
    "function_signature": "def num_decodings(s: str) -> int:",
    "reference_solution": "def num_decodings(s):\n    if not s or s[0] == '0': return 0\n    n = len(s)\n    dp = [0] * (n + 1)\n    dp[0], dp[1] = 1, 1\n    for i in range(2, n + 1):\n        if s[i-1] != '0': dp[i] += dp[i-1]\n        two = int(s[i-2:i])\n        if 10 <= two <= 26: dp[i] += dp[i-2]\n    return dp[n]",
    "tests": [
      {
        "id": 0,
        "input": "num_decodings('12')",
        "expected": "2"
      },
      {
        "id": 1,
        "input": "num_decodings('226')",
        "expected": "3"
      },
      {
        "id": 2,
        "input": "num_decodings('06')",
        "expected": "0"
      },
      {
        "id": 3,
        "input": "num_decodings('10')",
        "expected": "1"
      },
      {
        "id": 4,
        "input": "num_decodings('1')",
        "expected": "1"
      },
      {
        "id": 5,
        "input": "num_decodings('27')",
        "expected": "1"
      },
      {
        "id": 6,
        "input": "num_decodings('11106')",
        "expected": "2"
      },
      {
        "id": 7,
        "input": "num_decodings('0')",
        "expected": "0"
      },
      {
        "id": 8,
        "input": "num_decodings('111')",
        "expected": "3"
      },
      {
        "id": 9,
        "input": "num_decodings('2101')",
        "expected": "1"
      },
      {
        "id": 10,
        "input": "num_decodings('')",
        "expected": "0"
      },
      {
        "id": 11,
        "input": "num_decodings('x')",
        "expected": "1"
      },
      {
        "id": 12,
        "input": "num_decodings('0uo2kq503v')",
        "expected": "0"
      },
      {
        "id": 13,
        "input": "num_decodings('a')",
        "expected": "1"
      },
      {
        "id": 14,
        "input": "num_decodings('k')",
        "expected": "1"
      },
      {
        "id": 15,
        "input": "num_decodings('94')",
        "expected": "1"
      },
      {
        "id": 16,
        "input": "num_decodings(' ')",
        "expected": "1"
      },
      {
        "id": 17,
        "input": "num_decodings('8')",
        "expected": "1"
      },
      {
        "id": 18,
        "input": "num_decodings('v')",
        "expected": "1"
      },
      {
        "id": 19,
        "input": "num_decodings('z')",
        "expected": "1"
      }
    ]
  },
  {
    "id": 34,
    "category": "system_style",
    "title": "Leaky Bucket",
    "description": "Implement a LeakyBucket(capacity, leak_rate) where capacity is max tokens, leak_rate is tokens leaked per second. Method add(tokens, timestamp) adds tokens (returns True if accepted, False if overflow), and get_level(timestamp) returns current token level.",
    "difficulty": 7,
    "function_signature": "class LeakyBucket:\n    def __init__(self, capacity: float, leak_rate: float): ...\n    def add(self, tokens: float, timestamp: float) -> bool: ...\n    def get_level(self, timestamp: float) -> float: ...",
    "reference_solution": "class LeakyBucket:\n    def __init__(self, capacity, leak_rate):\n        self.capacity = capacity\n        self.leak_rate = leak_rate\n        self.level = 0.0\n        self.last_time = 0.0\n    def _leak(self, timestamp):\n        elapsed = timestamp - self.last_time\n        self.level = max(0.0, self.level - elapsed * self.leak_rate)\n        self.last_time = timestamp\n    def add(self, tokens, timestamp):\n        self._leak(timestamp)\n        if self.level + tokens > self.capacity:\n            return False\n        self.level += tokens\n        return True\n    def get_level(self, timestamp):\n        self._leak(timestamp)\n        return self.level",
    "tests": [
      {
        "id": 0,
        "input": "lb = LeakyBucket(10, 1); lb.add(5, 0)",
        "expected": "True"
      },
      {
        "id": 1,
        "input": "lb = LeakyBucket(10, 1); lb.add(10, 0); lb.add(1, 0)",
        "expected": "False"
      },
      {
        "id": 2,
        "input": "lb = LeakyBucket(10, 1); lb.add(10, 0); lb.get_level(5)",
        "expected": "5.0"
      },
      {
        "id": 3,
        "input": "lb = LeakyBucket(10, 2); lb.add(10, 0); lb.add(2, 1)",
        "expected": "True"
      },
      {
        "id": 4,
        "input": "lb = LeakyBucket(10, 1); lb.get_level(0)",
        "expected": "0.0"
      },
      {
        "id": 5,
        "input": "lb = LeakyBucket(10, 1); lb.add(10, 0); lb.get_level(10)",
        "expected": "0.0"
      },
      {
        "id": 6,
        "input": "lb = LeakyBucket(10, 1); lb.add(10, 0); lb.get_level(100)",
        "expected": "0.0"
      },
      {
        "id": 7,
        "input": "lb = LeakyBucket(5, 1); lb.add(3, 0); lb.add(3, 0)",
        "expected": "False"
      },
      {
        "id": 8,
        "input": "lb = LeakyBucket(10, 5); lb.add(10, 0); lb.add(5, 1)",
        "expected": "True"
      },
      {
        "id": 9,
        "input": "lb = LeakyBucket(10, 1); lb.add(5, 0); lb.add(5, 0); lb.get_level(5)",
        "expected": "5.0"
      }
    ]
  },
  {
    "id": 35,
    "category": "edge_cases",
    "title": "String to Integer (atoi)",
    "description": "Implement `my_atoi(s)` which converts a string to a 32-bit signed integer. Skip leading whitespace, parse optional sign (+/-), read digits until a non-digit or end. Clamp to [-2^31, 2^31-1] range.",
    "difficulty": 5,
    "function_signature": "def my_atoi(s: str) -> int:",
    "reference_solution": "def my_atoi(s):\n    s = s.lstrip()\n    if not s: return 0\n    sign = 1\n    i = 0\n    if s[0] in '+-':\n        sign = -1 if s[0] == '-' else 1\n        i = 1\n    num = 0\n    while i < len(s) and s[i].isdigit():\n        num = num * 10 + int(s[i])\n        i += 1\n    num *= sign\n    INT_MAX, INT_MIN = 2**31 - 1, -(2**31)\n    return max(INT_MIN, min(INT_MAX, num))",
    "tests": [
      {
        "id": 0,
        "input": "my_atoi('42')",
        "expected": "42"
      },
      {
        "id": 1,
        "input": "my_atoi('   -42')",
        "expected": "-42"
      },
      {
        "id": 2,
        "input": "my_atoi('4193 with words')",
        "expected": "4193"
      },
      {
        "id": 3,
        "input": "my_atoi('words and 987')",
        "expected": "0"
      },
      {
        "id": 4,
        "input": "my_atoi('-91283472332')",
        "expected": "-2147483648"
      },
      {
        "id": 5,
        "input": "my_atoi('91283472332')",
        "expected": "2147483647"
      },
      {
        "id": 6,
        "input": "my_atoi('')",
        "expected": "0"
      },
      {
        "id": 7,
        "input": "my_atoi('+1')",
        "expected": "1"
      },
      {
        "id": 8,
        "input": "my_atoi('  ')",
        "expected": "0"
      },
      {
        "id": 9,
        "input": "my_atoi('+-12')",
        "expected": "0"
      },
      {
        "id": 10,
        "input": "my_atoi('y8ymb0k')",
        "expected": "0"
      },
      {
        "id": 11,
        "input": "my_atoi('a')",
        "expected": "0"
      },
      {
        "id": 12,
        "input": "my_atoi('97xbnqsfz')",
        "expected": "97"
      },
      {
        "id": 13,
        "input": "my_atoi('mzzajfcby6a4zu0lfpae6mm0stna43ysu45fzaxrdpzsv6')",
        "expected": "0"
      },
      {
        "id": 14,
        "input": "my_atoi('q49')",
        "expected": "0"
      },
      {
        "id": 15,
        "input": "my_atoi('edywj7sumb')",
        "expected": "0"
      },
      {
        "id": 16,
        "input": "my_atoi('f9w2c0elvaw1qc72vf3ts3d82u9kf')",
        "expected": "0"
      },
      {
        "id": 17,
        "input": "my_atoi('aoahqc')",
        "expected": "0"
      },
      {
        "id": 18,
        "input": "my_atoi('jgt4apoi9swr')",
        "expected": "0"
      },
      {
        "id": 19,
        "input": "my_atoi('bfru71sy8rkv709c32vcqoqr7y856ae3bs3c')",
        "expected": "0"
      }
    ]
  },
  {
    "id": 36,
    "category": "algorithmic",
    "title": "Rotate Array",
    "description": "Given an array `nums` and integer `k`, rotate the array to the right by `k` steps in-place. Return the modified array.",
    "difficulty": 3,
    "function_signature": "def rotate(nums: list[int], k: int) -> list[int]:",
    "reference_solution": "def rotate(nums, k):\n    n = len(nums)\n    k = k % n\n    nums[:] = nums[-k:] + nums[:-k] if k else nums[:]\n    return nums",
    "tests": [
      {
        "id": 0,
        "input": "rotate([1,2,3,4,5,6,7], 3)",
        "expected": "[5, 6, 7, 1, 2, 3, 4]"
      },
      {
        "id": 1,
        "input": "rotate([-1,-100,3,99], 2)",
        "expected": "[3, 99, -1, -100]"
      },
      {
        "id": 2,
        "input": "rotate([1,2], 3)",
        "expected": "[2, 1]"
      },
      {
        "id": 3,
        "input": "rotate([1], 0)",
        "expected": "[1]"
      },
      {
        "id": 4,
        "input": "rotate([1,2,3], 0)",
        "expected": "[1, 2, 3]"
      },
      {
        "id": 5,
        "input": "rotate([1,2,3], 3)",
        "expected": "[1, 2, 3]"
      },
      {
        "id": 6,
        "input": "rotate([1,2,3,4], 1)",
        "expected": "[4, 1, 2, 3]"
      },
      {
        "id": 7,
        "input": "rotate([1,2,3,4], 2)",
        "expected": "[3, 4, 1, 2]"
      },
      {
        "id": 8,
        "input": "rotate([1,2,3,4,5], 5)",
        "expected": "[1, 2, 3, 4, 5]"
      },
      {
        "id": 9,
        "input": "rotate([1,2,3,4,5], 10)",
        "expected": "[1, 2, 3, 4, 5]"
      },
      {
        "id": 10,
        "input": "rotate([3, -4, 5, -6, -4, 2, -3, -6, 5], 21)",
        "expected": "[-3, -6, 5, 3, -4, 5, -6, -4, 2]"
      },
      {
        "id": 11,
        "input": "rotate([-6, 514], 0)",
        "expected": "[-6, 514]"
      },
      {
        "id": 12,
        "input": "rotate([0, -3, -3, 3], -1)",
        "expected": "[-3, -3, 3, 0]"
      },
      {
        "id": 13,
        "input": "rotate([-219, 249, 682, 891, 657, 955, -893, 775, -937, 755, -948, -948, -719, -367, -962, 675, 800, -507, -633, 782, 803, -19, -613, 968], 0)",
        "expected": "[-219, 249, 682, 891, 657, 955, -893, 775, -937, 755, -948, -948, -719, -367, -962, 675, 800, -507, -633, 782, 803, -19, -613, 968]"
      },
      {
        "id": 14,
        "input": "rotate([1, 0, 3, -8, 0], -27)",
        "expected": "[3, -8, 0, 1, 0]"
      },
      {
        "id": 15,
        "input": "rotate([-600, -554], 2)",
        "expected": "[-600, -554]"
      },
      {
        "id": 16,
        "input": "rotate([-8, -2], 4)",
        "expected": "[-8, -2]"
      },
      {
        "id": 17,
        "input": "rotate([387, -594, 421, -39, 436, 608, 293, -871, 80, -213, 660, 441, -933, -24, 74], 6)",
        "expected": "[-213, 660, 441, -933, -24, 74, 387, -594, 421, -39, 436, 608, 293, -871, 80]"
      },
      {
        "id": 18,
        "input": "rotate([-7, -9, -10, -10, 6, 2], -32)",
        "expected": "[-10, -10, 6, 2, -7, -9]"
      },
      {
        "id": 19,
        "input": "rotate([859], -1)",
        "expected": "[859]"
      }
    ]
  },
  {
    "id": 37,
    "category": "data_structures",
    "title": "Top K Frequent Elements",
    "description": "Given an integer array `nums` and integer `k`, return the `k` most frequent elements. Return them in any order.",
    "difficulty": 5,
    "function_signature": "def top_k_frequent(nums: list[int], k: int) -> list[int]:",
    "reference_solution": "from collections import Counter\nimport heapq\ndef top_k_frequent(nums, k):\n    count = Counter(nums)\n    return heapq.nlargest(k, count.keys(), key=count.get)",
    "tests": [
      {
        "id": 0,
        "input": "sorted(top_k_frequent([1,1,1,2,2,3], 2))",
        "expected": "[1, 2]"
      },
      {
        "id": 1,
        "input": "top_k_frequent([1], 1)",
        "expected": "[1]"
      },
      {
        "id": 2,
        "input": "sorted(top_k_frequent([1,2,3,1,2,1], 1))",
        "expected": "[1]"
      },
      {
        "id": 3,
        "input": "sorted(top_k_frequent([4,1,-1,2,-1,2,3], 2))",
        "expected": "[-1, 2]"
      },
      {
        "id": 4,
        "input": "sorted(top_k_frequent([1,2], 2))",
        "expected": "[1, 2]"
      },
      {
        "id": 5,
        "input": "len(top_k_frequent([1,1,2,2,3], 2))",
        "expected": "2"
      },
      {
        "id": 6,
        "input": "top_k_frequent([3,3,3], 1)",
        "expected": "[3]"
      },
      {
        "id": 7,
        "input": "sorted(top_k_frequent([5,5,5,4,4,3], 3))",
        "expected": "[3, 4, 5]"
      },
      {
        "id": 8,
        "input": "top_k_frequent([1,1,1], 1)",
        "expected": "[1]"
      },
      {
        "id": 9,
        "input": "len(top_k_frequent([1,2,3,4,5], 3))",
        "expected": "3"
      },
      {
        "id": 10,
        "input": "top_k_frequent([4, 1, 8, 6], -26)",
        "expected": "[]"
      },
      {
        "id": 11,
        "input": "top_k_frequent([-27], -2)",
        "expected": "[]"
      },
      {
        "id": 12,
        "input": "top_k_frequent([5, 3], -13)",
        "expected": "[]"
      },
      {
        "id": 13,
        "input": "top_k_frequent([-934, 253, 461, 660, -845, 867, -266, -658, 209, -132, 284, -196, -350, 318, 623, -969, 808, 152, -90, 552, -280, 964, -375, 313, 396, -909, 679], 15)",
        "expected": "[-934, 253, 461, 660, -845, 867, -266, -658, 209, -132, 284, -196, -350, 318, 623]"
