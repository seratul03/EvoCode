  {
    "id": 40,
    "category": "algorithmic",
    "title": "Trapping Rain Water",
    "description": "Given `height`, a list of non-negative integers representing an elevation map where each bar is width 1, compute how much water it can trap after raining.",
    "difficulty": 7,
    "function_signature": "def trap(height: list[int]) -> int:",
    "reference_solution": "def trap(height):\n    lo, hi = 0, len(height) - 1\n    left_max = right_max = water = 0\n    while lo < hi:\n        if height[lo] < height[hi]:\n            if height[lo] >= left_max: left_max = height[lo]\n            else: water += left_max - height[lo]\n            lo += 1\n        else:\n            if height[hi] >= right_max: right_max = height[hi]\n            else: water += right_max - height[hi]\n            hi -= 1\n    return water",
    "tests": [
      {
        "id": 0,
        "input": "trap([0,1,0,2,1,0,1,3,2,1,2,1])",
        "expected": "6"
      },
      {
        "id": 1,
        "input": "trap([4,2,0,3,2,5])",
        "expected": "9"
      },
      {
        "id": 2,
        "input": "trap([])",
        "expected": "0"
      },
      {
