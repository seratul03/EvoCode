  {
    "id": 38,
    "category": "string_parsing",
    "title": "Minimum Window Substring",
    "description": "Given strings `s` and `t`, return the minimum window substring of `s` that contains all characters in `t`. If no such window exists, return ''. All characters of `t` must be present with at least the frequency they appear in `t`.",
    "difficulty": 8,
    "function_signature": "def min_window(s: str, t: str) -> str:",
    "reference_solution": "from collections import Counter\ndef min_window(s, t):\n    need = Counter(t)\n    missing = len(t)\n    start = ans_start = ans_end = 0\n    for end, c in enumerate(s, 1):\n        if need[c] > 0: missing -= 1\n        need[c] -= 1\n        if missing == 0:\n            while need[s[start]] < 0:\n                need[s[start]] += 1\n                start += 1\n            if ans_end == 0 or end - start < ans_end - ans_start:\n                ans_start, ans_end = start, end\n            need[s[start]] += 1\n            missing += 1\n            start += 1\n    return s[ans_start:ans_end]",
    "tests": [
      {
        "id": 0,
        "input": "min_window('ADOBECODEBANC', 'ABC')",
        "expected": "BANC"
      },
      {
        "id": 1,
        "input": "min_window('a', 'a')",
        "expected": "a"
      },
      {
        "id": 2,
        "input": "min_window('a', 'aa')",
        "expected": ""
      },
      {
        "id": 3,
        "input": "min_window('ab', 'b')",
        "expected": "b"
      },
      {
        "id": 4,
        "input": "min_window('bba', 'ab')",
        "expected": "ba"
      },
      {
        "id": 5,
        "input": "min_window('', 'a')",
        "expected": ""
      },
      {
        "id": 6,
        "input": "len(min_window('cabwefgewcwaefgcf', 'cae'))",
        "expected": "4"
      },
      {
        "id": 7,
        "input": "min_window('aa', 'aa')",
        "expected": "aa"
      },
      {
        "id": 8,
        "input": "min_window('abc', 'cba')",
        "expected": "abc"
      },
      {
        "id": 9,
        "input": "min_window('ADOBECODEBANC', 'A')",
        "expected": "A"
      },
      {
        "id": 10,
        "input": "min_window('z0uqxd0u', 'g1t0c1z0')",
        "expected": "''"
      },
      {
        "id": 11,
        "input": "min_window('', '')",
        "expected": "''"
      },
      {
        "id": 12,
        "input": "min_window('hfb', 'jgat14fxmfre')",
        "expected": "''"
      },
      {
        "id": 13,
        "input": "min_window('d5xo8pwtx4k5ps6xjn8umawgl0q8pcmk', 'w0cu4r715r7hqxckbx7pv9kejbtil3h')",
        "expected": "''"
      },
      {
        "id": 14,
        "input": "min_window('qsu7', 'f20v9ohas1x')",
        "expected": "''"
      },
      {
        "id": 15,
        "input": "min_window('a', ' ')",
        "expected": "''"
      },
      {
        "id": 16,
        "input": "min_window('jozzt68zx8', 'fm')",
        "expected": "''"
      },
      {
