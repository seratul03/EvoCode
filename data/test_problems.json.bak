  {
    "id": 39,
    "category": "edge_cases",
    "title": "Sqrt Without Math",
    "description": "Compute the integer square root of `x` (the largest integer r such that r^2 <= x). Do not use `math.sqrt` or `**0.5`. Use binary search.",
    "difficulty": 4,
    "function_signature": "def my_sqrt(x: int) -> int:",
    "reference_solution": "def my_sqrt(x):\n    if x < 2: return x\n    lo, hi = 1, x // 2\n    while lo <= hi:\n        mid = (lo + hi) // 2\n        if mid * mid == x: return mid\n        elif mid * mid < x: lo = mid + 1\n        else: hi = mid - 1\n    return hi",
    "tests": [
      {
        "id": 0,
        "input": "my_sqrt(4)",
        "expected": "2"
      },
      {
        "id": 1,
        "input": "my_sqrt(8)",
        "expected": "2"
      },
      {
        "id": 2,
        "input": "my_sqrt(0)",
        "expected": "0"
      },
      {
        "id": 3,
        "input": "my_sqrt(1)",
        "expected": "1"
      },
