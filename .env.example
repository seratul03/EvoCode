# EvoCode Environment Configuration Example
# Copy this file to .env and configure the variables for your setup.

# ==============================================================================
# Tier 1: Local Model (Ollama)
# ==============================================================================
# Base URL for Ollama's API (defaults to http://localhost:11434/v1)
OLLAMA_BASE_URL=http://localhost:11434/v1

# The local model you want to use with Ollama (e.g., qwen2.5-coder:32b, llama3:8b)
OLLAMA_MODEL=qwen2.5-coder:32b


# ==============================================================================
# Tier 2: Cloud Fallback (Groq)
# ==============================================================================
# Your Groq API key(s)
# You can provide a single key:
GROQ_API_KEY=your_groq_api_key_here

# Or multiple comma-separated keys for load balancing / rate limit rotation:
# GROQ_API_KEYS=key1,key2,key3

# Or index-based keys:
# GROQ_API_KEY_1=key1
# GROQ_API_KEY_2=key2

# The Groq model to use (e.g., llama-3.1-70b-versatile, llama-3.1-8b-instant)
GROQ_MODEL=llama-3.1-70b-versatile

# Groq Rate Limits (defaults: RPM=30, TPM=14400)
# GROQ_RPM=30
# GROQ_TPM=14400


# ==============================================================================
# Tier 3: Cloud Fallback (OpenRouter)
# ==============================================================================
# Your OpenRouter API key
OPENROUTER_API_KEY=your_openrouter_api_key_here

# The OpenRouter model to use (e.g., anthropic/claude-3.5-sonnet)
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# OpenRouter Rate Limits (defaults: RPM=10, TPM=0)
# OPENROUTER_RPM=10
# OPENROUTER_TPM=0


# ==============================================================================
# General Settings
# ==============================================================================
# Directory to store structured run reports (defaults to structured_reports)
# EVOCODE_REPORT_DIR=structured_reports

# Maximum number of total LLM API calls allowed (defaults to 9999)
# TOTAL_CALL_BUDGET=9999
